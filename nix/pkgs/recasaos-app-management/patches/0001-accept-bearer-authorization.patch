+package route
+
+import "strings"
+
+// authorizationToken returns the token carried by an Authorization header value. The standard form is
+// `Bearer <token>` (what the ReCasaOS root service and the current UI use); the bare token is still
+// accepted, as before. ReCasaNix (docs/upstream-exclusions.md): without this, a UI that satisfies the
+// root service (Bearer) is rejected here, and one that satisfies this service (bare) is rejected there.
+func authorizationToken(header string) string {
+	return strings.TrimPrefix(header, "Bearer ")
+}
