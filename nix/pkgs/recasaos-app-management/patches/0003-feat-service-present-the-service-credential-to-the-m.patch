From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ppenguin <hieronymusv@gmail.com>
Date: Wed, 7 Oct 2026 16:23:38 +0200
Subject: [PATCH 3/4] feat(service): present the service credential to the
 message bus

The generated message bus client now sends the gateway's per-start
service credential (gatewayclient.ServiceRequestEditor) to the loopback
bus. Today the bus still exempts loopback, so this changes nothing on
its own; it lets the bus require the credential instead
(ReCasaOS-MessageBus: "loopback needs the service credential").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 service/message_bus_credential_test.go | 46 ++++++++++++++++++++++++++
 service/service.go                     |  2 +-
 2 files changed, 47 insertions(+), 1 deletion(-)
 create mode 100644 service/message_bus_credential_test.go

diff --git a/service/message_bus_credential_test.go b/service/message_bus_credential_test.go
new file mode 100644
index 0000000..11e59d2
--- /dev/null
+++ b/service/message_bus_credential_test.go
@@ -0,0 +1,46 @@
+package service
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/IceWhaleTech/CasaOS-Common/external"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/pkg/config"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/pkg/gatewayclient"
+)
+
+// The message bus no longer takes loopback as an identity: the client presents
+// the gateway's per-start service credential on every call to it.
+func TestMessageBusClientSendsServiceCredential(t *testing.T) {
+	const token = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+
+	authorization := make(chan string, 1)
+	bus := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		authorization <- r.Header.Get("Authorization")
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte("[]"))
+	}))
+	defer bus.Close()
+
+	runtimePath := t.TempDir()
+	if err := os.WriteFile(filepath.Join(runtimePath, external.MessageBusAddressFilename), []byte(bus.URL), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(runtimePath, gatewayclient.ServiceTokenFilename), []byte(token+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	previous := config.CommonInfo.RuntimePath
+	config.CommonInfo.RuntimePath = runtimePath
+	t.Cleanup(func() { config.CommonInfo.RuntimePath = previous })
+
+	if _, err := (&store{}).MessageBus().GetEventTypesWithResponse(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if got := <-authorization; got != "Bearer "+token {
+		t.Fatalf("Authorization = %q, want the service credential", got)
+	}
+}
diff --git a/service/service.go b/service/service.go
index d3a856e..ddc328d 100644
--- a/service/service.go
+++ b/service/service.go
@@ -89,7 +89,7 @@ func (c *store) Docker() DockerService {
 }
 
