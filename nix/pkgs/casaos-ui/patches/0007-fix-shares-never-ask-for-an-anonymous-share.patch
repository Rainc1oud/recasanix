 src/components/filebrowser/components/ContextMenu.vue  | 2 +-
 src/components/filebrowser/modals/NewFolderModal.vue   | 2 +-
 src/components/filebrowser/shared/SelectShareModal.vue | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

