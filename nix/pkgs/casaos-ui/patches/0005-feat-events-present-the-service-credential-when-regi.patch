From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ppenguin <hieronymusv@gmail.com>
Date: Wed, 7 Oct 2026 16:23:55 +0200
Subject: [PATCH 5/8] feat(events): present the service credential when
 registering UI events

register-ui-events.sh posts the dashboard's event types to the message
bus over loopback. It now sends the gateway's per-start service
credential (/var/run/casaos/gateway.token), so the bus can stop taking
loopback as an identity (ReCasaOS-MessageBus: "loopback needs the
service credential"). The header goes through a process substitution,
so the credential never appears on a command line. Without the file
the request is sent as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 register-ui-events.sh | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/register-ui-events.sh b/register-ui-events.sh
index 85efb60..c8ae349 100644
--- a/register-ui-events.sh
+++ b/register-ui-events.sh
@@ -6,10 +6,20 @@
 # Get the message bus URL
 runtime_file="/var/run/casaos/message-bus.url"
 ui_message_bus_file="/var/lib/casaos/ui-message-bus.json"
+token_file="/var/run/casaos/gateway.token"
 if [ -f "$runtime_file" ] && [ -f "$ui_message_bus_file" ]
 then
     MESSAGE_BUS_URL=$(cat /var/run/casaos/message-bus.url)
-    curl -X POST "$MESSAGE_BUS_URL/v2/message_bus/event_type" -H "Content-Type: application/json" -d @$ui_message_bus_file
+    # The gateway's per-start service credential: the message bus does not take
+    # loopback as an identity. Passed through a file descriptor (printf is a
+    # builtin) so it never appears on a command line.
+    if [ -r "$token_file" ]
+    then
+        curl -X POST "$MESSAGE_BUS_URL/v2/message_bus/event_type" -H "Content-Type: application/json" \
+            -H @<(printf 'Authorization: Bearer %s\n' "$(< "$token_file")") -d @$ui_message_bus_file
+    else
+        curl -X POST "$MESSAGE_BUS_URL/v2/message_bus/event_type" -H "Content-Type: application/json" -d @$ui_message_bus_file
+    fi
     echo "UI events registered"
 else
     echo "Message bus URL or message json file not found"
