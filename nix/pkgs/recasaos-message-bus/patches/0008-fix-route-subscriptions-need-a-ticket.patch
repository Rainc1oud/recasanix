From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ppenguin <hieronymusv@gmail.com>
Date: Wed, 7 Oct 2026 18:09:41 +0200
Subject: [PATCH 8/8] fix(route): subscriptions need a ticket

Removes the exemption that let every WebSocket subscription handshake
through without credentials. A browser now subscribes with a one-use
ticket (POST /v2/message_bus/ticket, previous change); in-stack services
keep the unix socket and the gateway service credential; anything else
needs a user token.

Requires the dashboard to send tickets first (ReCasaOS-UI: "subscribe to
the message bus with a ticket"); merge after it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 route/routers.go     |  5 -----
 route/ticket_test.go | 26 +++++++++++++++++++++++---
 2 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/route/routers.go b/route/routers.go
index 2d31094..85da620 100644
--- a/route/routers.go
+++ b/route/routers.go
@@ -62,11 +62,6 @@ func NewAPIRouter(swagger *openapi3.T, services *service.Services) (http.Handler
 				}
 			}
 
-			// TODO(tickets): removed once the dashboard sends a ticket
-			if c.Request().Method == echo.GET && c.Request().Header.Get(echo.HeaderUpgrade) == "websocket" {
-				return true
-			}
-
 			return false
 		},
 		ParseTokenFunc: func(token string, c echo.Context) (interface{}, error) {
diff --git a/route/ticket_test.go b/route/ticket_test.go
index 46d64c9..ffb2e1a 100644
--- a/route/ticket_test.go
+++ b/route/ticket_test.go
@@ -70,11 +70,14 @@ func TestSubscriptionTicketsAreBounded(t *testing.T) {
 
 // newTicketTestRouter is the real API router with a user service that serves
 // its JWKS, and a signed access token for user 7.
+// One key pair for all tests: CasaOS-Common caches the fetched public key
+// process-wide for a few seconds.
+var ticketTestKey, _, _ = jwt.GenerateKeyPair()
+
 func newTicketTestRouter(t *testing.T) (http.Handler, string) {
 	t.Helper()
-	privateKey, publicKey, err := jwt.GenerateKeyPair()
-	assert.NilError(t, err)
-	jwks, err := jwt.GenerateJwksJSON(publicKey)
+	privateKey := ticketTestKey
+	jwks, err := jwt.GenerateJwksJSON(&privateKey.PublicKey)
 	assert.NilError(t, err)
 	userService := httptest.NewServer(jwt.JWKSHandler(jwks))
 	t.Cleanup(userService.Close)
@@ -138,3 +141,20 @@ func TestSubscriptionTicketThroughTheRouter(t *testing.T) {
 	_, ok := subscriptionTickets.consume(ticketRequest(cookie.Value, "browser"))
 	assert.Assert(t, !ok, "the handshake did not redeem the ticket")
 }
+
+// Without a ticket (or a user token, or the in-stack credentials) a
+// subscription handshake is refused: the open WebSocket exemption is gone.
+func TestSubscriptionHandshakeNeedsATicket(t *testing.T) {
+	router, token := newTicketTestRouter(t)
+	subscriptionTickets = newSubscriptionTicketRegistry()
+
+	assert.Equal(t, serve(router, handshake(nil)).Code, http.StatusUnauthorized)
+	assert.Equal(t, serve(router, handshake(&http.Cookie{Name: subscriptionTicketCookie, Value: "forged"})).Code, http.StatusUnauthorized)
+
+	request := httptest.NewRequest(http.MethodPost, "/v2/message_bus/ticket", nil)
+	request.Header.Set("Authorization", token)
+	cookie := serve(router, request).Result().Cookies()[0]
+	ticket := &http.Cookie{Name: cookie.Name, Value: cookie.Value}
+	assert.Assert(t, serve(router, handshake(ticket)).Code != http.StatusUnauthorized, "a ticketed handshake was refused")
+	assert.Equal(t, serve(router, handshake(ticket)).Code, http.StatusUnauthorized, "a replayed ticket")
+}
