From: ppenguin <hieronymusv@gmail.com>
Date: Wed, 7 Oct 2026 16:19:24 +0200
Subject: [PATCH 4/6] security(route): take unix-socket identity from the
 connection, not the Host header

The JWT skipper let a request through when its Host header was "unix".
The Host header is chosen by the client: any TCP peer could send it, and
the gateway's reverse proxy forwards it unchanged, so a LAN client could
reach the whole bus API without a token.

A request now counts as coming from the unix socket only when it arrived
on that listener, read from the connection's local address
(http.LocalAddrContextKey). The in-tree socket clients (app-management's
PublishEventInSocket) are unaffected. The socket file is chmod 0600
explicitly, since skipping authentication there relies on only root
being able to connect.

Loopback and websocket exemptions are unchanged here (follow-ups).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 main.go               |  6 +++++
 route/routers.go      | 15 +++++++++--
 route/routers_test.go | 58 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 2 deletions(-)
 create mode 100644 route/routers_test.go

diff --git a/main.go b/main.go
index 61d70fc..b44179b 100644
--- a/main.go
+++ b/main.go
@@ -127,6 +127,12 @@ func main() {
 	if err != nil {
 		panic(err)
 	}
+	// Requests on this socket skip authentication (route.fromUnixSocket), so
+	// only root may connect, whatever the umask: connect(2) needs write
+	// permission on the socket file.
+	if err := os.Chmod(unixSocketPath, 0o600); err != nil {
+		panic(err)
+	}
 
 	// register at gateway
 	u, err := url.Parse(swagger.Servers[0].URL)
diff --git a/route/routers.go b/route/routers.go
index 73aea00..7b878f6 100644
--- a/route/routers.go
+++ b/route/routers.go
@@ -2,6 +2,7 @@ package route
 
 import (
 	"crypto/ecdsa"
+	"net"
 	"net/http"
 	"net/url"
 	"strconv"
@@ -39,8 +40,8 @@ func NewAPIRouter(swagger *openapi3.T, services *service.Services) (http.Handler
 
 	e.Use(echo_middleware.JWTWithConfig(echo_middleware.JWTConfig{
 		Skipper: func(c echo.Context) bool {
-			// skip when source is unix socket
-			if c.Request().Host == "unix" {
+			// skip when the request really arrived on the unix socket listener
+			if fromUnixSocket(c.Request()) {
 				return true
 			}
 
@@ -83,6 +84,16 @@ func NewAPIRouter(swagger *openapi3.T, services *service.Services) (http.Handler
 	return e, nil
 }
 
+// fromUnixSocket reports whether a request came in on the unix socket listener
+// (main.go), which only root can connect to. It is read from the connection's
+// local address: the Host header ("unix" from the in-tree socket clients) is
+// chosen by the client, so any TCP peer, including one forwarded by the
+// gateway, could send it.
+func fromUnixSocket(r *http.Request) bool {
+	addr, ok := r.Context().Value(http.LocalAddrContextKey).(net.Addr)
+	return ok && addr.Network() == "unix"
+}
