From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ppenguin <hieronymusv@gmail.com>
Date: Wed, 7 Oct 2026 17:03:10 +0200
Subject: [PATCH 2/6] fix(service): startup races in the event and action
 dispatch

Services.Start runs EventServiceWS.Start and ActionServiceWS.Start in
goroutines, and main.go starts YSKService right after it. Two races
followed:

- A subscription made before Start ran was lost: Subscribe creates the
  subscriber map lazily and Start replaced it unconditionally. YSK's
  subscription to its own card events could vanish at startup, and
  dashboard cards then never updated. Start now keeps an existing map
  (event and action service).
- An event published before Start ran dereferenced a nil context and
  panicked. Publish now reads the inbound channel and context under the
  lock and drops the event when the service is not started, as it
  already drops events nobody listens to.

TestEventTypeService published once and relied on Start having run (it
panicked under load); it now publishes until the event arrives. New
tests cover both races; they fail without the fix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 service/action_service_websocket.go     |  5 +-
 service/event_service_websocket.go      | 24 +++++++--
 service/event_service_websocket_test.go | 66 +++++++++++++++++++++++++
 service/event_type_service_test.go      | 28 +++++++++--
 4 files changed, 112 insertions(+), 11 deletions(-)
 create mode 100644 service/event_service_websocket_test.go

diff --git a/service/action_service_websocket.go b/service/action_service_websocket.go
index 5c78328..94fe456 100644
--- a/service/action_service_websocket.go
+++ b/service/action_service_websocket.go
@@ -124,7 +124,10 @@ func (s *ActionServiceWS) Start(ctx *context.Context) {
 	s.mutex = sync.Mutex{}
 
 	s.inboundChannel = make(chan model.Action)
-	s.subscriberChannels = make(map[string]map[string][]chan model.Action)
+	// keep subscriptions made before Start ran (see EventServiceWS.Start)
+	if s.subscriberChannels == nil {
+		s.subscriberChannels = make(map[string]map[string][]chan model.Action)
+	}
 	s.stop = make(chan struct{})
 
 	defer func() {
diff --git a/service/event_service_websocket.go b/service/event_service_websocket.go
index 34518e2..a8075f7 100644
--- a/service/event_service_websocket.go
+++ b/service/event_service_websocket.go
@@ -25,8 +25,17 @@ type EventServiceWS struct {
 var mutex = &sync.Mutex{}
 
 func (s *EventServiceWS) Publish(event model.Event) {
-	if s.inboundChannel == nil {
+	// Start runs in a goroutine (Services.Start) and sets both under the lock;
+	// an event published before that is dropped, as one nobody listens to,
+	// instead of dereferencing a nil context.
+	inboundChannel, ctx := func() (chan model.Event, *context.Context) {
+		mutex.Lock()
+		defer mutex.Unlock()
+		return s.inboundChannel, s.ctx
+	}()
+	if inboundChannel == nil || ctx == nil {
 		logger.Error("error when publishing event via websocket", zap.Error(ErrInboundChannelNotFound))
+		return
 	}
 
 	if event.Timestamp == 0 {
@@ -36,10 +45,10 @@ func (s *EventServiceWS) Publish(event model.Event) {
 	// TODO - ensure properties are valid for event type
 
 	select {
-	case s.inboundChannel <- event:
+	case inboundChannel <- event:
 
-	case <-(*s.ctx).Done():
-		if err := (*s.ctx).Err(); err != nil {
+	case <-(*ctx).Done():
+		if err := (*ctx).Err(); err != nil {
 			logger.Info(err.Error())
 		}
 		return
@@ -136,7 +145,12 @@ func (s *EventServiceWS) Start(ctx *context.Context) {
 		s.ctx = ctx
 
 		s.inboundChannel = make(chan model.Event)
-		s.subscriberChannels = make(map[string]map[string][]chan model.Event)
+		// Keep subscriptions made before Start ran: Services.Start launches
+		// this in a goroutine and YSKService subscribes right after it, so
+		// replacing the map here silently dropped that subscription.
+		if s.subscriberChannels == nil {
+			s.subscriberChannels = make(map[string]map[string][]chan model.Event)
+		}
 		s.stop = make(chan struct{})
 	}()
 
diff --git a/service/event_service_websocket_test.go b/service/event_service_websocket_test.go
