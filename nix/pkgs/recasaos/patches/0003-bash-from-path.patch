--- /dev/null
+++ b/service/system_bash.go
@@ -0,0 +1,11 @@
+package service
+
+import "os/exec"
+
+// onlyExec replaces CasaOS-Common's command.OnlyExec, which hardcodes /bin/bash. ReCasaNix (NixOS)
+// has no /bin/bash; the bare name resolves through the service unit's PATH (docs/upstream-exclusions.md).
+func onlyExec(cmdStr string) (string, error) {
+	cmd := exec.Command("bash", "-c", cmdStr)
+	buf, err := cmd.CombinedOutput()
+	return string(buf), err
+}
